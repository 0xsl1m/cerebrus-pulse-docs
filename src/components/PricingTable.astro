---
import prices from '../data/prices.json';
import { priceOf, usd } from '../lib/pricing.mjs';
import acp from '../data/acp.json';
import { delivers } from '../lib/acp.mjs';

const x402EndpointList = [
  {
    method: 'GET',
    path: '/screener',
    description: 'Market screener',
    details: 'Scan 50+ coins at once: signal strength, RSI zone, trend direction, vol regime, funding bias, confluence, OI trend. The entry point for market-wide analysis.',
    params: 'top_n=50',
  },
  {
    method: 'GET',
    path: '/pulse/{coin}',
    description: 'Multi-timeframe technical analysis',
    details: 'RSI, EMAs (20/50/200), ATR, Bollinger Bands, VWAP, Z-score, trend detection, confluence scoring, derivatives data, market regime',
    params: 'timeframes=1h,4h',
  },
  {
    method: 'GET',
    path: '/sentiment',
    description: 'Market sentiment analysis',
    details: 'Aggregated sentiment labels across the crypto market',
    params: 'none',
  },
  {
    method: 'GET',
    path: '/funding/{coin}',
    description: 'Funding rate analysis',
    details: 'Hourly funding rate statistics over 1-168 hours, annualized as hourly rates',
    params: 'lookback_hours=24',
  },
  {
    method: 'GET',
    path: '/oi/{coin}',
    description: 'Open interest analysis',
    details: 'Current OI, delta over 1h/4h/24h, percentile rank, trend direction, and price-OI divergence signals',
    params: 'none',
  },
  {
    method: 'GET',
    path: '/spread/{coin}',
    description: 'Spread & liquidity analysis',
    details: 'Impact spread, uncalibrated slippage estimates at $10k-$500k notional, and a liquidity score.',
    params: 'none',
  },
  {
    method: 'GET',
    path: '/correlation',
    description: 'Correlation matrix',
    details: 'Correlation of 1h returns between BTC and 14 large perpetuals over a 30h, 7d or 30d window, with sample sizes, sector averages and a regime label',
    params: 'none',
  },
  {
    method: 'GET',
    path: '/arb',
    description: 'Market Stress Index',
    details: 'Cross-chain arbitrage-derived market stress signal. Aggregates price dislocations across DEXs into a single stress level: LOW, MODERATE, HIGH, or EXTREME.',
    params: 'none',
  },
  {
    method: 'GET',
    path: '/basis/{coin}',
    description: 'Chainlink basis analysis',
    details: 'The Hyperliquid perp premium (mark vs its oracle), which funding follows, plus how far the Hyperliquid oracle sits from Chainlink spot.',
    params: 'none',
    tag: 'Chainlink',
  },
  {
    method: 'GET',
    path: '/cex-dex/{token}',
    description: 'CEX-DEX divergence',
    details: 'Coinbase against on-chain (Chainlink or DEX) prices for the tokens the scanner covers. Divergence in basis points with its direction.',
    params: 'none',
  },
  {
    method: 'GET',
    path: '/depeg',
    description: 'USDC collateral health',
    details: 'Real-time USDC peg status via Chainlink oracle on Arbitrum. Monitors stablecoin deviation from $1.00 with risk levels and Arbitrum sequencer health.',
    params: 'none',
    tag: 'Chainlink',
  },
  {
    method: 'GET',
    path: '/liquidations/{coin}',
    description: 'Liquidation heatmap',
    details: 'Modelled liquidation zones by leverage tier (3x up to the market maximum) for longs and shorts, from open interest and Hyperliquid margin rules, with cascade risk and the nearest cluster.',
    params: 'none',
    hot: true,
  },
  {
    method: 'GET',
    path: '/bundle/{coin}',
    description: 'Complete analysis bundle',
    details: 'The /pulse output, 24-hour funding statistics and sentiment for one coin in one request.',
    params: 'timeframes=1h,4h',
    highlight: true,
  },
];

// Prices come from the gateway's payment routes (src/data/prices.json, F010).
const x402Endpoints = x402EndpointList.map((ep) => ({
  ...ep,
  price: usd(priceOf(prices, ep.path.split('/')[1])),
}));

// ACP v2 offerings from the provider's own definitions (src/data/acp.json, F009):
// each delivers the engine's JSON for one coin; none calls a model.
const ACP_TIERS = { cerebrus_lite: 'Lite', cerebrus_synthesis: 'Standard', cerebrus_premium: 'Premium' };
const acpTiers = acp.offerings
  .filter((o) => o.name in ACP_TIERS)
  .map((o) => ({
    tier: ACP_TIERS[o.name as keyof typeof ACP_TIERS],
    price: `$${o.budget_usdc}`,
    description: `The /${o.endpoint} output`,
    details: `The engine's JSON for one coin: ${delivers(o)}, in USDC on Base through ACP escrow.`,
  }));

const freeEndpoints = [
  { method: 'GET', path: '/health', description: 'Gateway health status' },
  { method: 'GET', path: '/coins', description: 'List available coins' },
];
---

<div class="section-divider"></div>
<section class="landing-section landing-section-dark" id="pricing">
  <div class="mx-auto max-w-5xl">
    <div class="section-eyebrow" data-reveal="slide-up">02 · Pricing</div>
    <h2 class="mb-4 text-center text-3xl font-bold md:text-4xl text-[#E8ECF4]" data-reveal="slide-up">
      <span class="gradient-text">Pay Per Query</span>
    </h2>
    <p class="mb-4 text-center text-[#94A3B8] text-base sm:text-lg" data-reveal="slide-up">Three protocols. Two chains. Same intelligence.</p>
    <p class="mb-8 sm:mb-12 text-center text-sm text-[#64748B]" data-reveal="slide-up">
      x402 for structured data via HTTP (Base or Solana). A2A for agent-to-agent discovery. ACP for Virtuals Protocol agents (paused).
    </p>

    <!-- x402 Pricing -->
    <div class="flex items-center gap-3 mb-6">
      <span class="hero-badge-x402 !text-xs">x402</span>
      <h3 class="text-base font-semibold text-[#94A3B8]">USDC micropayments on Base + Solana</h3>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {x402Endpoints.map((ep) => (
        <div class={`price-card ${ep.highlight ? 'price-card-highlight' : ''}`} data-reveal="stagger">
          <div class="mb-3 flex items-center justify-between">
            <code class="text-sm font-mono">
              <span class="text-[#60A5FA]">{ep.method}</span>{' '}
              <span class="text-[#CBD5E1]">{ep.path}</span>
            </code>
            <span class={ep.highlight ? 'price-badge-acp' : 'price-badge'}>{ep.price} USDC</span>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-[#E8ECF4]">{ep.description}</h3>
          <p class="mb-3 text-sm text-[#94A3B8]">{ep.details}</p>
          {ep.params !== 'none' && (
            <div class="text-xs text-[#64748B]">
              Params: <code class="text-[#94A3B8]">{ep.params}</code>
            </div>
          )}
          {ep.tag === 'Chainlink' && (
            <div class="mt-3">
              <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium"
                    style="background: rgba(55, 91, 210, 0.1); color: #375BD2; border: 1px solid rgba(55, 91, 210, 0.2);">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 37.9 43.6" fill="currentColor">
                  <path d="M18.9 0l-4 2.3L4 8.6 0 10.9v21.8l4 2.3 10.9 6.3 4 2.3 4-2.3L33.8 34.9l4-2.3V10.9l-4-2.3L22.9 2.3 18.9 0zm0 5.5l10.2 5.9v11.8L18.9 29.1 8.7 23.2V11.4L18.9 5.5z"/>
                </svg>
                Powered by Chainlink
              </span>
            </div>
          )}
          {ep.highlight && (
            <div class="mt-3">
              <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium"
                    style="background: rgba(59, 130, 246, 0.1); color: #60A5FA; border: 1px solid rgba(59, 130, 246, 0.2);">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd"/>
                </svg>
                Three endpoints, one request
              </span>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="duality-line my-10" data-reveal="grow"></div>

    <!-- ACP Pricing -->
    <div class="flex items-center gap-3 mb-6">
      <span class="hero-badge-acp !text-xs">ACP</span>
      <h3 class="text-base font-semibold text-[#94A3B8]">Data tiers via Virtuals Protocol (paused)</h3>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {acpTiers.map((tier) => (
        <div class="price-card" data-reveal="stagger">
          <div class="mb-3 flex items-center justify-between">
            <span class="text-sm font-mono font-semibold text-[#FBBF24]">{tier.tier}</span>
            <span class="price-badge">{tier.price}</span>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-[#E8ECF4]">{tier.description}</h3>
          <p class="text-sm text-[#94A3B8]">{tier.details}</p>
        </div>
      ))}
    </div>

    <!-- Free Endpoints -->
    <div class="mt-8 rounded-xl p-6" style="background: rgba(17, 24, 39, 0.5); border: 1px solid rgba(30, 41, 59, 0.6);">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-[#64748B]">Free Endpoints</h3>
      <div class="grid gap-3 sm:grid-cols-2">
        {freeEndpoints.map((ep) => (
          <div class="flex items-center gap-3">
            <code class="text-sm font-mono">
              <span class="text-[#60A5FA]">{ep.method}</span>{' '}
              <span class="text-[#CBD5E1]">{ep.path}</span>
            </code>
            <span class="text-sm text-[#64748B]"> -- {ep.description}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
