<canvas id="brain-3d-canvas" class="brain-3d-canvas" aria-hidden="true"></canvas>

<script>
  import { parseMinWidth, shouldLoadBrain3D } from '../scripts/brain3d-gate.js';

  // Load gate: skip the scene for reduced-motion and save-data visitors, and
  // below PUBLIC_BRAIN3D_MIN_WIDTH px when that build variable is set (unset:
  // every viewport, as before). Otherwise fetch three.js only after the page
  // has loaded and the main thread is idle, so it never competes with content.
  function scheduleBrain3D() {
    const load = shouldLoadBrain3D({
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      saveData: (navigator as any).connection?.saveData === true,
      viewportWidth: window.innerWidth,
      minWidth: parseMinWidth(import.meta.env.PUBLIC_BRAIN3D_MIN_WIDTH),
    });
    if (!load) return;
    // The scene module statically imports three, so both land in one lazy
    // chunk that is only requested here.
    const start = () => {
      import('../scripts/brain3d-scene')
        .then(({ initBrain3D }) => initBrain3D())
        .catch((err) => console.warn('Brain3D: scene failed to load', err));
    };
    const whenIdle = () => {
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 2000 });
      else setTimeout(start, 200);
    };
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  }

  scheduleBrain3D();
  document.addEventListener('astro:page-load', scheduleBrain3D);
</script>

<style>
  .brain-3d-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    opacity: 0.85;
    filter: brightness(1.25) contrast(1.15);
  }
</style>
