---
import prices from '../data/prices.json';
import { priceOf, priceRange, usd } from '../lib/pricing.mjs';

// x402 prices come from the gateway's payment routes (src/data/prices.json, F010).
const range = priceRange(prices);

interface Props {
  title?: string;
  description?: string;
  url?: string;
}

const {
  title = "Cerebrus Pulse — Real-time Crypto Intelligence API",
  description = `Cerebrus Pulse is a pay-per-query crypto intelligence API for 50+ Hyperliquid perpetuals. x402 micropayments and Google A2A agent-to-agent discovery. From ${usd(range.min)}/query. No API keys required.`,
  url = "https://cerebruspulse.xyz",
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Archon Digital LLC",
  "url": "https://archondigital.xyz",
  "sameAs": ["https://github.com/0xsl1m"],
  "brand": {
    "@type": "Brand",
    "name": "Cerebrus Pulse"
  },
  "description": "Cerebrus Pulse is a real-time crypto intelligence API for Hyperliquid perpetuals, a product of Archon Digital LLC."
};

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cerebrus Pulse",
  "url": url,
  "description": description,
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": "Cryptocurrency Analysis API",
  "operatingSystem": "Any (REST API)",
  "browserRequirements": "HTTP client with x402 SDK support",
  "offers": [
    {
      "@type": "Offer",
      "name": "Pulse — Multi-timeframe Technical Analysis",
      "description": "RSI, EMAs (20/50/200), ATR, Bollinger Bands, VWAP, Z-score, trend detection, confluence scoring, derivatives data, and market regime for any Hyperliquid perpetual.",
      "price": priceOf(prices, "pulse"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "pulse"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/pulse"
    },
    {
      "@type": "Offer",
      "name": "Sentiment — Market Sentiment Analysis",
      "description": "A bucketed crypto market sentiment label built from the live inputs of a multi-source collector.",
      "price": priceOf(prices, "sentiment"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "sentiment"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/sentiment"
    },
    {
      "@type": "Offer",
      "name": "Funding — Funding Rate Analysis",
      "description": "Hourly Hyperliquid funding rate statistics over 1-168 hours, correctly annualized.",
      "price": priceOf(prices, "funding"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "funding"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/funding"
    },
    {
      "@type": "Offer",
      "name": "Screener — Market Screener",
      "description": "Scan 50+ coins at once for signal strength, RSI zone, trend direction, volatility regime, funding bias, confluence, and OI trend.",
      "price": priceOf(prices, "screener"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "screener"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/screener"
    },
    {
      "@type": "Offer",
      "name": "Open Interest — OI Analysis",
      "description": "Current OI, delta over 1h/4h/24h, percentile rank, trend direction, and price-OI divergence signals.",
      "price": priceOf(prices, "oi"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "oi"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/oi"
    },
    {
      "@type": "Offer",
      "name": "Spread — Liquidity Analysis",
      "description": "Hyperliquid impact spread, uncalibrated slippage estimates at several order sizes, and a liquidity score.",
      "price": priceOf(prices, "spread"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "spread"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/spread"
    },
    {
      "@type": "Offer",
      "name": "Correlation — BTC-Alt Correlation Matrix",
      "description": "Correlation of 1h returns between BTC and 14 large perpetuals over a 30-hour, 7-day or 30-day window, with sector averages and a regime label.",
      "price": priceOf(prices, "correlation"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "correlation"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/correlation"
    },
    {
      "@type": "Offer",
      "name": "Bundle — Complete Analysis Bundle",
      "description": "The /pulse output, 24-hour funding statistics and market sentiment for one asset in one request.",
      "price": priceOf(prices, "bundle"),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": priceOf(prices, "bundle"),
        "priceCurrency": "USD",
        "unitText": "per query"
      },
      "url": url + "/api/bundle"
    }
  ],
  "featureList": [
    "Market screener: scan 50+ coins at once",
    "Multi-timeframe technical analysis (5m, 15m, 1h, 4h, 1d, 1w)",
    "RSI, EMA (20/50/200), ATR, Bollinger Bands, VWAP, Z-score indicators",
    "Confluence vote share (0-1) across four indicators",
    "Market regime label",
    "Open interest analysis with divergence detection",
    "Spread and liquidity scoring with slippage estimates",
    "BTC-alt correlation matrix with regime classification",
    "Derivatives data (hourly funding, open interest, impact spread)",
    "Market sentiment analysis",
    "50+ Hyperliquid perpetuals supported",
    "x402 micropayments on Base or Solana (USDC)",
    "Google A2A agent-to-agent protocol with Agent Card discovery",
    "ACP (Virtuals Protocol) data tiers, currently paused",
    "No API keys or subscriptions required",
    `Pay-per-query pricing from ${usd(range.min)}`
  ],
  "creator": {
    "@type": "Organization",
    "name": "Archon Digital LLC",
    "url": "https://archondigital.xyz"
  }
};

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Cerebrus Pulse API Documentation",
  "description": "Complete API reference for Cerebrus Pulse: endpoints, response schemas, rate limits, code examples for x402 micropayments, A2A agent-to-agent protocol, and ACP agent commerce integration.",
  "url": url + "/overview",
  "about": {
    "@type": "WebApplication",
    "name": "Cerebrus Pulse"
  },
  "author": {
    "@type": "Organization",
    "name": "Archon Digital LLC",
    "url": "https://archondigital.xyz"
  },
  "proficiencyLevel": "Beginner",
  "dependencies": "x402 SDK (Python or TypeScript) for micropayments, A2A JSON-RPC for agent-to-agent, or ACP SDK for Virtuals Protocol agent integration"
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Cerebrus Pulse",
  "description": "Real-time crypto intelligence API for Hyperliquid perpetuals. Multi-timeframe technical analysis, sentiment, and funding data via x402 micropayments, A2A protocol, or ACP agent commerce.",
  "brand": {
    "@type": "Brand",
    "name": "Cerebrus Pulse"
  },
  "manufacturer": {
    "@type": "Organization",
    "name": "Archon Digital LLC",
    "url": "https://archondigital.xyz"
  },
  "category": "Cryptocurrency Analysis API",
  "url": url,
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": range.min,
    "highPrice": range.max,
    "priceCurrency": "USD",
    "offerCount": webApplicationSchema.offers.length
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
